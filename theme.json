{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": [
				"page"
			],
			"title": "Page (No Title / Feature Image)"
		},
		{
			"name": "page-with-sidebar",
			"postTypes": [
				"page"
			],
			"title": "Page With Sidebar"
		},
		{
			"name": "page-wide",
			"postTypes": [
				"page"
			],
			"title": "Page with wide Image"
		}
	],
	"patterns": [
		"three-columns-of-services",
		"clients-section"
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [
				{
					"colors": [
						"#111111",
						"#ffffff"
					],
					"name": "Black and white",
					"slug": "duotone-1"
				},
				{
					"colors": [
						"#111111",
						"#C2A990"
					],
					"name": "Black and sandstone",
					"slug": "duotone-2"
				},
				{
					"colors": [
						"#111111",
						"#D8613C"
					],
					"name": "Black and rust",
					"slug": "duotone-3"
				},
				{
					"colors": [
						"#111111",
						"#B1C5A4"
					],
					"name": "Black and sage",
					"slug": "duotone-4"
				},
				{
					"colors": [
						"#111111",
						"#B5BDBC"
					],
					"name": "Black and pastel blue",
					"slug": "duotone-5"
				}
			],
			"gradients": [
				{
					"gradient": "linear-gradient(to bottom, #cfcabe 0%, #F9F9F9 100%)",
