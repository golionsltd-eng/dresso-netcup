			"core/post-terms": {
				"css": "& .wp-block-post-terms__prefix{color: var(--wp--preset--color--contrast-2);}",
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
